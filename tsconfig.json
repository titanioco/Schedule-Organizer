{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "outDir": "./static/js",
    "rootDir": "./src/typescript",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node"
  },
  "include": ["src/typescript/**/*"],
  "exclude": ["node_modules"]
}
